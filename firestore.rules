rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      // Only signed-in (anonymous) players can touch rooms.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && code.size() == 5
        && request.resource.data.code == code
        && request.resource.data.v == 2
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 6
        && (resource == null || resource.data.status != 'playing'
            || request.resource.data.players.size() == resource.data.players.size());
      allow delete: if false;
    }
  }
}
